@page "/settings"
@using LangNotebook.Helper
@using LangNotebook.Service
@inject AppState State
@inject SettingsService SettingsSvc
@inject BackupService Backup
@inject IJSRuntime JS

<PageTitle>Cài đặt · Sổ tay ngoại ngữ</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h1>Cài đặt</h1>
            <p class="page-sub">Toàn bộ dữ liệu nằm trong trình duyệt trên máy bạn, không gửi đi đâu cả</p>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Mục tiêu học</h2>
        </div>

        <div class="form-grid">
            <label class="field">
                <span>Số lượt ôn mỗi ngày</span>
                <input class="input" type="number" min="5" step="5" @bind="_settings.DailyReviewGoal" />
            </label>

            <label class="field">
                <span>Số từ viết mỗi tuần</span>
                <input class="input" type="number" min="50" step="50" @bind="_settings.WeeklyWritingGoal" />
            </label>

            <label class="field">
                <span>Thẻ mới mỗi phiên</span>
                <input class="input" type="number" min="0" step="1" @bind="_settings.NewCardsPerSession" />
            </label>

            <label class="field">
                <span>Tối đa thẻ mỗi phiên</span>
                <input class="input" type="number" min="5" step="5" @bind="_settings.MaxCardsPerSession" />
            </label>

            <label class="field">
                <span>Chiều hỏi mặc định</span>
                <select class="select" value="@((int)_settings.DefaultDirection)" @onchange="OnDirectionChanged">
                    <option value="0">Xem từ → nhớ nghĩa</option>
                    <option value="1">Xem nghĩa → nhớ từ</option>
                    <option value="2">Trộn cả hai chiều</option>
                </select>
            </label>

            <label class="field">
                <span>Tên hiển thị</span>
                <input class="input" @bind="_settings.DisplayName" @bind:event="oninput" />
            </label>
        </div>

        <div class="modal-foot">
            <button class="btn btn-primary" @onclick="SaveSettingsAsync">Lưu cài đặt</button>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Sao lưu &amp; khôi phục</h2>
        </div>

        <p class="muted">
            Dữ liệu chỉ nằm trên máy này. Nếu xoá dữ liệu trình duyệt hoặc đổi máy, hãy tải bản sao lưu trước.
        </p>

        <div class="button-row">
            <button class="btn" @onclick="ExportJsonAsync">Tải file JSON</button>
            <button class="btn" @onclick="ExportDbAsync">Tải file SQLite (.db)</button>
        </div>

        <hr />

        <label class="field">
            <span>Khôi phục từ file (.json hoặc .db)</span>
            <InputFile OnChange="OnFileSelected" accept=".json,.db" class="input" />
        </label>

        <label class="check">
            <input type="checkbox" checked="@_replaceOnImport" @onchange="OnReplaceChanged" />
            Xoá dữ liệu hiện có trước khi nạp (chỉ áp dụng cho file JSON)
        </label>

        @if (!string.IsNullOrEmpty(_importMessage))
        {
            <div class="callout">@_importMessage</div>
        }
    </div>

    <div class="card danger-zone">
        <div class="card-head">
            <h2>Xoá toàn bộ dữ liệu</h2>
        </div>
        <p class="muted">Thao tác này xoá sạch mọi sổ, từ vựng, cấu trúc và bài viết trên máy này. Không thể hoàn tác.</p>
        <button class="btn btn-danger" @onclick="WipeAsync">Xoá sạch và tạo lại dữ liệu mẫu</button>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>Về ứng dụng</h2>
        </div>
        <ul class="score-list">
            <li><span>Nền tảng</span><span>Blazor WebAssembly (.NET 8) + C#</span></li>
            <li><span>Cơ sở dữ liệu</span><span>SQLite qua EF Core, lưu trong IndexedDB</span></li>
            <li><span>Thuật toán ôn tập</span><span>SM-2 (lặp lại ngắt quãng)</span></li>
            <li><span>Kết nối mạng</span><span>Không cần – chạy được offline</span></li>
        </ul>
    </div>
</div>
