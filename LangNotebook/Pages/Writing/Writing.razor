@page "/writing"
@using LangNotebook.Components
@using LangNotebook.Helper
@using LangNotebook.Service
@implements IDisposable
@inject AppState State
@inject WritingService Writings
@inject LibraryService Library
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SettingsService SettingsSvc

<PageTitle>Writing Practice · Language Notebook</PageTitle>

<div class="mx-auto w-full max-w-[1100px] px-4 pb-24 pt-6 sm:px-8 sm:pt-10 lg:px-16">
    <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
        <div class="min-w-0">
            <h1 class="m-0 mt-3 text-[28px] font-semibold leading-tight tracking-tight text-ink sm:text-[38px]">Writing Practice</h1>
            <p class="m-0 mt-1 text-sm text-mute">@_pieces.Count articles · @_pieces.Sum(x => x.WordCount) words written</p>
        </div>

        <div class="flex items-center gap-2">
            <button type="button" class="nt-btn h-10! px-4!" @onclick="@(() => OpenPromptEditor(null))">
                Add prompt
            </button>
            <button type="button" class="nt-btn nt-btn-primary h-10! px-4!" @onclick="@(() => Nav.NavigateTo("writing/new"))">
                <Icon Name="plus" Size="14" /> Write new article
            </button>
        </div>
    </div>
    <section aria-label="This week" class="nt-card mt-6 grid grid-cols-1 overflow-hidden sm:grid-cols-3">
        <div class="border-b border-line px-5 py-4 sm:border-b-0 sm:border-r">
            <div class="text-xs font-semibold uppercase tracking-[0.04em] text-mute">Weekly goal</div>
            <div class="text-[26px] font-semibold leading-tight">
                @WordsThisWeek.ToString("#,0") <span class="text-sm font-normal text-mute">/ @_weeklyGoal.ToString("#,0") words</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-hov" role="progressbar" aria-label="Weekly writing goal"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@GoalPercent">
                <div class="h-full rounded-full bg-nt-accent" style="width: @(GoalPercent)%"></div>
            </div>
        </div>
        <div class="border-b border-line px-5 py-4 sm:border-b-0 sm:border-r">
            <div class="text-xs font-semibold uppercase tracking-[0.04em] text-mute">Average score</div>
            <div class="text-[26px] font-semibold leading-tight">
                @(AverageScore?.ToString() ?? "—") <span class="text-sm font-normal text-mute">/ 100</span>
            </div>
            <div class="text-xs text-mute">automated grading</div>
        </div>
        <div class="px-5 py-4">
            <div class="text-xs font-semibold uppercase tracking-[0.04em] text-mute">Drafts</div>
            <div class="text-[26px] font-semibold leading-tight">@DraftCount</div>
            <div class="text-xs text-mute">waiting to be finished</div>
        </div>
    </section>

    <section class="mt-10" aria-labelledby="wl-prompts">
        <h2 id="wl-prompts" class="m-0 text-xl font-semibold text-ink">Prompt bank</h2>
        <p class="m-0 mt-0.5 text-sm text-mute">Choose a prompt to start writing with target word counts and suggested vocabulary.</p>
        @if (_prompts.Count == 0)
        {
            <div class="mt-3 flex gap-2.5 rounded-nt bg-nt-side px-3 py-2.5 text-sm text-ink [box-shadow:inset_0_0_0_1px_var(--nt-line)]">
                <p class="m-0">No prompts available. Add custom prompts to practice regularly.</p>
            </div>
        }
        else
        {
            <div class="mt-4 grid grid-cols-1 items-start gap-5 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var prompt in _prompts)
                {
                    <article @key="prompt.Id"
                             class="nt-card group flex min-w-0 flex-col gap-2.5 p-4 transition-shadow hover:shadow-pop">
                        <header class="-mx-4 -mt-4 flex items-start justify-between gap-3 border-b border-index px-4 py-3">
                            <h3 class="m-0 min-w-0 break-words text-base font-semibold leading-snug text-ink">@prompt.Title</h3>
                            <span class="nt-tag nt-tag-5 shrink-0">@Labels.Level(prompt.Level)</span>
                        </header>

                        <p class="m-0 line-clamp-3 text-sm text-mute">@prompt.PromptText</p>

                        @if (prompt.SuggestedTermList.Length > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var term in prompt.SuggestedTermList)
                                {
                                    <span class="max-w-full break-all rounded-full px-2.5 text-xs leading-[22px] text-mute [box-shadow:inset_0_0_0_1px_var(--nt-press)]">@term</span>
                                }
                            </div>
                        }
                        <footer class="-mx-4 -mb-4 mt-auto flex items-center justify-between gap-2 border-t border-line px-4 py-3">
                            @{ var promptNotebook = NotebookOf(prompt.NotebookId); }
                            <span class="flex min-w-0 items-center gap-3 text-[13px] text-mute">
                                @if (promptNotebook is not null)
                                {
                                    <span class="inline-flex min-w-0 items-center gap-1.5">
                                        <span class="h-2.5 w-2.5 shrink-0 rounded-[2px]" style="background: @promptNotebook.ColorHex"></span>
                                        <span class="truncate">@promptNotebook.Name</span>
                                    </span>
                                }
                                <span class="shrink-0">@prompt.TargetWordCount words</span>
                            </span>

                            <div class="-mr-1 flex items-center gap-0.5">
                                <span class="flex gap-0.5 transition-opacity md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100">
                                    <button type="button" class="nt-icon-btn" title="Edit prompt" aria-label="Edit prompt" @onclick="@(() => OpenPromptEditor(prompt))"><Icon Name="edit" Size="14" /></button>
                                    <button type="button" class="nt-icon-btn is-danger" title="Delete prompt" aria-label="Delete prompt" @onclick="@(() => DeletePromptAsync(prompt))"><Icon Name="trash" Size="14" /></button>
                                </span>
                                <button type="button" class="nt-btn ml-1"
                                        @onclick="@(() => Nav.NavigateTo($"writing/new?promptId={prompt.Id}"))">Write this</button>
                            </div>
                        </footer>
                    </article>
                }
            </div>
        }
    </section>

    <section class="nt-card mt-10" aria-labelledby="wl-pieces">
        <div class="nt-card-head">
            <h2 id="wl-pieces">Written articles</h2>
            <div class="relative min-w-[12rem] flex-1 sm:max-w-xs sm:flex-none">
                <span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-faint">
                    <Icon Name="search" Size="14" />
                </span>
                <input class="nt-input h-8! py-0! pl-8!" type="search" aria-label="Search articles"
                       placeholder="Search articles…" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>

        @if (_pieces.Count == 0)
        {
            <div class="flex flex-col items-center gap-2 px-4 py-14 text-center">
                <h3 class="m-0 text-base font-semibold text-ink">@(string.IsNullOrWhiteSpace(_search) ? "No articles yet" : "No articles match your search")</h3>
                <p class="m-0 max-w-sm text-sm text-mute">Pick a prompt above or start a new article.</p>
                <button type="button" class="nt-btn nt-btn-primary mt-2" @onclick="@(() => Nav.NavigateTo("writing/new"))">
                    <Icon Name="plus" Size="14" /> Write new article
                </button>
            </div>
        }
        else
        {
            <div class="nt-scroll overflow-x-auto">
                <table class="w-full min-w-[760px] border-collapse text-sm">
                    <thead>
                    <tr class="text-left text-xs text-mute">
                        <th scope="col" class="border-b border-line py-2.5 pl-5 pr-3 font-semibold">Title</th>
                        <th scope="col" class="border-b border-line px-3 py-2.5 font-semibold">Notebook</th>
                        <th scope="col" class="border-b border-line px-3 py-2.5 text-right font-semibold">Words</th>
                        <th scope="col" class="border-b border-line px-3 py-2.5 text-right font-semibold">Auto score</th>
                        <th scope="col" class="border-b border-line px-3 py-2.5 text-right font-semibold">Self score</th>
                        <th scope="col" class="border-b border-line px-3 py-2.5 font-semibold">Updated</th>
                        <th scope="col" class="border-b border-line py-2.5 pl-3 pr-5 text-right font-semibold">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var piece in _pieces)
                    {
                        var pieceNotebook = NotebookOf(piece.NotebookId);
                        <tr @key="piece.Id" class="hover:bg-hov">
                            <td class="border-b border-line py-3 pl-5 pr-3">
                                <a class="font-semibold text-ink no-underline hover:underline" href="@($"writing/{piece.Id}")">@piece.DisplayTitle</a>
                                @if (piece.Status == Models.WritingStatus.Draft)
                                {
                                    <span class="nt-tag nt-tag-0 ml-2">Draft</span>
                                }
                            </td>
                            <td class="whitespace-nowrap border-b border-line px-3 py-3 text-mute">
                                @if (pieceNotebook is not null)
                                {
                                    <span class="inline-flex items-center gap-1.5">
                                        <span class="h-2.5 w-2.5 rounded-[2px]" style="background: @pieceNotebook.ColorHex"></span>@pieceNotebook.Name
                                    </span>
                                }
                            </td>
                            <td class="border-b border-line px-3 py-3 text-right">
                                @piece.WordCount <span class="text-faint">/ @piece.TargetWordCount</span>
                            </td>
                            <td class="border-b border-line px-3 py-3 text-right">
                                <span class="@($"inline-flex h-9 w-9 items-center justify-center rounded-full border-[1.5px] border-current text-[13px] font-bold {ScoreInk(piece)}")">
                                    @(piece.AutoScore > 0 ? piece.AutoScore.ToString() : "—")
                                </span>
                            </td>
                            <td class="border-b border-line px-3 py-3 text-right text-mute">
                                @(piece.RubricTotal > 0 ? $"{piece.RubricTotal} / 20" : "—")
                            </td>
                            <td class="whitespace-nowrap border-b border-line px-3 py-3 text-mute">@Labels.RelativeDate(piece.UpdatedUtc)</td>
                            <td class="whitespace-nowrap border-b border-line py-3 pl-3 pr-5 text-right">
                                <a class="font-semibold no-underline hover:underline" href="@($"writing/{piece.Id}")">Open</a>
                                <button type="button" class="nt-icon-btn is-danger ml-1 align-middle" title="Delete"
                                        aria-label="@($"Delete {piece.DisplayTitle}")" @onclick="@(() => DeletePieceAsync(piece))">
                                    <Icon Name="trash" Size="14" />
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<Modal @bind-Visible="_promptEditorOpen" Title="@(_promptDraft.Id == 0 ? "Add Writing Prompt" : "Edit Prompt")" Size="lg">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <label class="block">
            <span class="nt-label">Notebook</span>
            <select class="nt-input" value="@_promptDraft.NotebookId" @onchange="OnPromptNotebookChanged">
                @foreach (var notebook in _notebooks)
                {
                    <option value="@notebook.Id">@notebook.Name</option>
                }
            </select>
        </label>

        <label class="block">
            <span class="nt-label">Topic</span>
            <input class="nt-input" @bind="_promptDraft.Topic" @bind:event="oninput" />
        </label>

        <label class="block sm:col-span-2">
            <span class="nt-label">Prompt Title *</span>
            <input class="nt-input" @bind="_promptDraft.Title" @bind:event="oninput" />
        </label>

        <label class="block sm:col-span-2">
            <span class="nt-label">Prompt Content *</span>
            <textarea class="nt-input" rows="4" @bind="_promptDraft.PromptText" @bind:event="oninput"></textarea>
        </label>

        <label class="block">
            <span class="nt-label">Target Word Count</span>
            <input class="nt-input tabular-nums" type="number" min="20" step="10" @bind="_promptDraft.TargetWordCount" />
        </label>

        <label class="block">
            <span class="nt-label">Level</span>
            <select class="nt-input" value="@((int)_promptDraft.Level)" @onchange="OnPromptLevelChanged">
                @foreach (var level in Levels)
                {
                    <option value="@((int)level)">@Labels.Level(level)</option>
                }
            </select>
        </label>

        <div class="block sm:col-span-2">
            <span class="nt-label">Suggested Vocabulary</span>
            <input class="nt-input" @bind="_promptDraft.SuggestedTerms" @bind:event="oninput" />
        </div>
    </div>

    <div class="mt-5 flex justify-end gap-2">
        <button type="button" class="nt-btn" @onclick="@(() => _promptEditorOpen = false)">Cancel</button>
        <button type="button" class="nt-btn nt-btn-primary" @onclick="SavePromptAsync" disabled="@(!CanSavePrompt)">Save</button>
    </div>
</Modal>

