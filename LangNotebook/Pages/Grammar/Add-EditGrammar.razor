@using LangNotebook.Components
@using LangNotebook.Helper

<Modal @bind-Visible="IsOpen" Title="@(Entry.Id == 0 ? "Add Pattern" : "Edit Pattern")" Size="lg">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <label class="block">
            <span class="nt-label">
                Notebook
            </span>
            <select class="nt-input" value="@Entry.NotebookId" @onchange="OnDraftNotebookChanged">
                @foreach (var notebook in Context.Notebooks)
                {
                    <option value="@notebook.Id">
                        @notebook.Name
                    </option>
                }
            </select>
        </label>
        <label class="block">
            <span class="nt-label">
                Topic
            </span>
            <input class="nt-input" @bind="Entry.Topic" @bind:event="oninput" placeholder="Conditional Sentences"/>
        </label>
        <label class="block sm:col-span-2">
            <span class="nt-label">
                Pattern / Formula *
            </span>
            <input class="nt-input font-mono text-xs" @bind="Entry.Pattern" @bind:event="oninput"
                   placeholder="If + S + V(past), S + would + V(bare infinity)"/>
        </label>
        <label class="block sm:col-span-2">
            <span class="nt-label">
                Meaning *
            </span>
            <input class="nt-input" @bind="Entry.Meaning" @bind:event="oninput"
                   placeholder="Hypothetical situations in the present"/>
        </label>
        <label class="block sm:col-span-2">
            <span class="nt-label">
                Usage Notes
            </span>
            <textarea class="nt-input" rows="3" @bind="Entry.Explanation" @bind:event="oninput">
            </textarea>
        </label>
        <label class="block sm:col-span-2">
            <span class="nt-label">
                Examples (one per line, use “ = ” to separate translation)
            </span>
            <textarea class="nt-input" rows="4" @bind="Entry.Examples" @bind:event="oninput"
                      placeholder="If I had time, I would learn Japanese. = If I had time, I would learn Japanese.">
            </textarea>
        </label>
        <label class="block sm:col-span-2">
            <span class="nt-label">
                Common Mistakes
            </span>
            <textarea class="nt-input" rows="2" @bind="Entry.CommonMistakes" @bind:event="oninput">
            </textarea>
        </label>
        <label class="block">
            <span class="nt-label">
                Tags (comma separated)
            </span>
            <input class="nt-input" @bind="Entry.Tags" @bind:event="oninput"/>
        </label>
        <label class="block">
            <span class="nt-label">Level</span>
            <select class="nt-input" value="@((int)Entry.Level)" @onchange="OnDraftLevelChanged">
                @foreach (var level in Context.Levels)
                {
                    <option value="@((int)level)">
                        @Labels.Level(level)
                    </option>
                }
            </select>
        </label>
        <label class="flex items-center gap-2 text-sm text-ink sm:col-span-2">
            <input type="checkbox" class="h-4 w-4 accent-[var(--nt-accent)]" checked="@Entry.IsSuspended"
                   @onchange="OnDraftSuspendedChanged"/>
            Suspend reviewing this pattern
        </label>
    </div>
    <div class="mt-5 flex justify-end gap-2">
        <button type="button" class="nt-btn" @onclick="CancelDraftAsync">
            Cancel
        </button>
        <button type="button" class="nt-btn nt-btn-primary" @onclick="SaveDraftAsync" disabled="@(!CanSave)">
            Save
        </button>
    </div>
</Modal>