@page "/Grammar"
@using LangNotebook.Components
@using LangNotebook.Helper
@using LangNotebook.Service
@implements IDisposable
@inject AppState State
@inject LibraryService Library
@inject ReviewService Reviews
@inject IJSRuntime JS

<PageTitle>Sentence Patterns &amp; Structures · Language Notebook</PageTitle>

<CascadingValue Value="_appContext">
    <div class="mx-auto w-full max-w-[1100px] px-4 pb-24 pt-6 sm:px-8 sm:pt-10 lg:px-16">
        <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
            <div class="min-w-0">
                <h1 class="m-0 mt-3 text-[28px] font-semibold leading-tight tracking-tight text-ink sm:text-[38px]">
                    Patterns &amp; Structures
                </h1>
                <p class="m-0 mt-1 text-sm text-mute">@_items.Count patterns recorded</p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="nt-btn nt-btn-primary" @onclick="@(() => OpenEditor(null))">
                    <Icon Name="plus" Size="14"/>
                    Add Pattern
                </button>
            </div>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-2 border-y border-line py-2">
            <div class="relative min-w-[12rem] flex-1 sm:max-w-xs">
                <span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-faint">
                    <Icon Name="search" Size="14"/>
                </span>
                <input class="nt-input h-8! py-0! pl-8! md:h-7!" type="search" aria-label="Search"
                       placeholder="Search patterns, meanings, examples…" value="@_filter.Search"
                       @oninput="OnSearchInput"/>
            </div>
            <label class="flex items-center gap-1.5 text-xs text-mute">
                <Icon Name="filter" Size="14"/>
                <select class="nt-input h-8! w-auto! py-0! text-xs md:h-7!" aria-label="Filter by tag"
                        value="@_filter.Tag" @onchange="OnTagChanged">
                    <option value="">
                        All Tags
                    </option>
                    @foreach (var tag in _tags)
                    {
                        <option value="@tag">
                            @tag
                        </option>
                    }
                </select>
            </label>
            <label class="flex items-center gap-1.5 text-xs text-mute">
                <Icon Name="sort" Size="14"/>
                <select class="nt-input h-8! w-auto! py-0! text-xs md:h-7!" aria-label="Sort by" value="@_filter.SortBy"
                        @onchange="OnSortChanged">
                    <option value="recent">
                        Recently Updated
                    </option>
                    <option value="alpha">
                        A → Z
                    </option>
                    <option value="due">
                        Due Soon
                    </option>
                    <option value="hardest">
                        Hardest to Recall
                    </option>
                </select>
            </label>
            <label
                class="nt-chip cursor-pointer has-checked:bg-nt-accent-soft has-checked:text-nt-accent has-checked:shadow-none has-focus-visible:outline-2 has-focus-visible:outline-nt-accent">
                <input type="checkbox" class="sr-only" checked="@_filter.OnlyDue" @onchange="OnDueChanged"/>
                <Icon Name="clock" Size="12"/>
                Due Only
            </label>
        </div>
        <div class="mt-4">
            @if (_loading)
            {
                <div class="grid grid-cols-1 gap-3 lg:grid-cols-2" aria-busy="true">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="h-36 animate-pulse rounded-nt bg-hov">
                        </div>
                    }
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="flex flex-col items-center gap-2 px-4 py-16 text-center">
                    <h2 class="m-0 text-base font-semibold text-ink">No structures recorded yet</h2>
                    <p class="m-0 max-w-sm text-sm text-mute">
                        Save patterns, usage notes, and a few sample sentences to review later.
                    </p>
                    <button type="button" class="nt-btn nt-btn-primary mt-2" @onclick="@(() => OpenEditor(null))">
                        <Icon Name="plus" Size="14"/>
                        Add First Pattern
                    </button>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 items-start gap-3 lg:grid-cols-2">
                    @foreach (var item in _items)
                    {
                        var stageTone = (int)item.Stage switch { 0 => 0, 1 => 2, 2 => 5, _ => 4 };
                        <article @key="item.Id"
                                 class="group flex min-w-0 flex-col gap-3 rounded-nt border border-line bg-nt-bg p-4 shadow-card transition-shadow hover:shadow-pop">
                            <header class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <h3 class="m-0 break-words font-mono text-sm font-semibold leading-snug text-ink">
                                        @item.Pattern
                                    </h3>
                                    <p class="m-0 mt-1 text-sm text-mute">
                                        @item.Meaning
                                    </p>
                                </div>
                                <div
                                    class="-mr-1 -mt-1 flex shrink-0 gap-0.5 transition-opacity md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100">
                                    <button type="button" class="nt-icon-btn" title="Edit" aria-label="Edit"
                                            @onclick="@(() => OpenEditor(item))">
                                        <Icon Name="edit" Size="14"/>
                                    </button>
                                    <button type="button" class="nt-icon-btn" title="Reset progress"
                                            aria-label="Reset progress" @onclick="@(() => ResetAsync(item))">
                                        <Icon Name="reset" Size="14"/>
                                    </button>
                                    <button type="button" class="nt-icon-btn is-danger" title="Delete"
                                            aria-label="Delete"
                                            @onclick="@(() => DeleteAsync(item))">
                                        <Icon Name="trash" Size="14"/>
                                    </button>
                                </div>
                            </header>
                            @if (!string.IsNullOrWhiteSpace(item.Explanation))
                            {
                                <p class="m-0 text-sm text-ink">
                                    @item.Explanation
                                </p>
                            }
                            @if (item.ExampleLines.Any())
                            {
                                <ul class="m-0 flex list-none flex-col gap-1.5 border-l-2 border-nt-press p-0 pl-3 text-sm text-ink">
                                    @foreach (var line in item.ExampleLines)
                                    {
                                        <li class="break-words">
                                            @line
                                        </li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.CommonMistakes))
                            {
                                <div
                                    class="flex gap-2 rounded-nt bg-[var(--tag-3-bg)] px-3 py-2 text-sm text-[color:var(--tag-3-fg)]">
                                    <span aria-hidden="true">⚠️</span>
                                    <p class="m-0 min-w-0 break-words">
                                        <strong class="font-semibold">Common
                                                                      mistakes:</strong> @item.CommonMistakes
                                    </p>
                                </div>
                            }
                            <footer class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1.5 pt-1">
                                <span class="nt-tag nt-tag-@(stageTone)">@Labels.Stage(item.Stage)</span>
                                <span class="text-xs text-faint">@Labels.Due(item)</span>
                                @if (!string.IsNullOrWhiteSpace(item.Topic))
                                {
                                    var topicTone = item.Topic.Trim().ToLowerInvariant().Sum(c => c) % 9;
                                    <span class="nt-tag nt-tag-@(topicTone)">@item.Topic</span>
                                }
                                @foreach (var tag in item.TagList)
                                {
                                    var tagTone = tag.Trim().ToLowerInvariant().Sum(c => c) % 9;
                                    <span class="nt-tag nt-tag-@(tagTone)">@tag</span>
                                }
                            </footer>
                        </article>
                    }
                </div>
            }
        </div>
    </div>

    <Add_EditGrammar @bind-IsOpen="_editorOpen" @bind-Entry="_draft" Tags="_tags" OnSaved="AddNewPattern"/>

</CascadingValue>

