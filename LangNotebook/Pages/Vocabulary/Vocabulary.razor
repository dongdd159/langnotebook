@page "/vocabulary"
@using LangNotebook.Components
@using LangNotebook.Helper
@using LangNotebook.Service
@implements IDisposable
@inject AppState State
@inject LibraryService Library
@inject ReviewService Reviews
@inject IJSRuntime JS

@{ SyncPage(); }

<CascadingValue Value="_appContext">
    <div class="mx-auto w-full max-w-[1100px] px-4 pb-24 pt-6 sm:px-8 sm:pt-10 lg:px-16">
        <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
            <div class="min-w-0">
                <h1 class="m-0 mt-3 text-[28px] font-bold leading-tight tracking-tight text-ink sm:text-[36px]">
                    Vocabulary Notebook
                </h1>
                <p class="m-0 mt-1 text-sm text-mute">
                    @_items.Count items · @DueInList items due for review ·
                    @(_notebooks.FirstOrDefault(x => x.Id == State.ActiveNotebookId)?.Name ?? "all notebooks")
                </p>
            </div>
            <div class="flex items-center gap-2 pb-1.5">
                <button type="button" class="nt-btn nt-btn-ghost" @onclick="OpenImport">
                    <Icon Name="upload" Size="14"/>
                    <span class="hidden sm:inline">
                        Bulk Import
                    </span>
                </button>
                <button type="button" class="nt-btn nt-btn-primary" @onclick="@(() => OpenEditor(null))">
                    <Icon Name="plus" Size="14" /> 
                    Add new word
                </button>
            </div>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-2 border-y border-line py-2">
            <div class="relative min-w-[12rem] flex-1 sm:max-w-xs">
                <span class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-faint">
                    <Icon Name="search" Size="14"/>
                </span>
                <input class="nt-input h-8! py-0! pl-8! md:h-7!" type="search" aria-label="Search"
                       placeholder="Search words, meanings, examples…" value="@_filter.Search" @oninput="OnSearchInput"/>
            </div>
            <label class="flex items-center gap-1.5 text-xs text-mute">
                <Icon Name="filter" Size="14"/>
                <select class="nt-input h-8! w-auto! py-0! text-xs md:h-7!" aria-label="Filter by tag" value="@_filter.Tag"
                        @onchange="OnTagChanged">
                    <option value="">
                        All tags
                    </option>
                    @foreach (var tag in _tags)
                    {
                        <option value="@tag">
                            @tag
                        </option>
                    }
                </select>
            </label>
            <label class="flex items-center gap-1.5 text-xs text-mute">
                <Icon Name="sort" Size="14"/>
                <select class="nt-input h-8! w-auto! py-0! text-xs md:h-7!" aria-label="Sort by" value="@_filter.SortBy"
                        @onchange="OnSortChanged">
                    <option value="recent">
                        Recently updated
                    </option>
                    <option value="oldest">
                        Oldest
                    </option>
                    <option value="alpha">
                        A → Z
                    </option>
                    <option value="due">
                        Due soon
                    </option>
                    <option value="hardest">
                        Hardest
                    </option>
                </select>
            </label>
            <label
                class="nt-chip cursor-pointer has-checked:bg-nt-accent-soft has-checked:text-nt-accent has-checked:shadow-none has-focus-visible:outline-2 has-focus-visible:outline-nt-accent">
                <input type="checkbox" class="sr-only" checked="@_filter.OnlyDue" @onchange="OnDueChanged"/>
                <Icon Name="clock" Size="12"/>
                Due
            </label>
            <label
                class="nt-chip cursor-pointer has-checked:bg-nt-accent-soft has-checked:text-nt-accent has-checked:shadow-none has-focus-visible:outline-2 has-focus-visible:outline-nt-accent">
                <input type="checkbox" class="sr-only" checked="@_filter.OnlyFavorite" @onchange="OnFavoriteChanged"/>
                <Icon Name="star" Size="12" Fill="@_filter.OnlyFavorite"/>
                Starred
            </label>
        </div>
        <div class="mt-3 scroll-mt-4 outline-none" tabindex="-1" @ref="_tableTop">
            @if (_loading)
            {
                <div class="flex flex-col gap-2" aria-busy="true">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="h-10 animate-pulse rounded-nt bg-hov">
                        </div>
                    }
                </div>
            }
            else if (_items.Count == 0)
            {
                <div class="flex flex-col items-center gap-2 px-4 py-16 text-center">
                    <h2 class="m-0 text-base font-semibold text-ink">
                        No words here yet
                    </h2>
                    <p class="m-0 max-w-sm text-sm text-mute">
                        Add new words using the “Add Word” button, or paste a list using “Bulk Import”.
                    </p>
                    <button type="button" class="nt-btn nt-btn-primary mt-2" @onclick="@(() => OpenEditor(null))">
                        <Icon Name="plus" Size="14"/>
                        Add first word
                    </button>
                </div>
            }
            else
            {
                var firstShown = (_pageIndex - 1) * _pageSize + 1;
                var lastShown = Math.Min(_pageIndex * _pageSize, _items.Count);
                <div role="table" aria-label="Vocabulary list" class="text-sm">
                    <div role="row"
                         class="hidden border-b border-line text-xs text-mute md:grid md:grid-cols-[minmax(0,26fr)_minmax(0,24fr)_minmax(0,28fr)_minmax(0,14fr)_minmax(0,8fr)]">
                        <div role="columnheader" class="flex items-center gap-1.5 px-2 py-1.5">
                            <Icon Name="type" Size="14"/>
                            Word
                        </div>
                        <div role="columnheader" class="flex items-center gap-1.5 px-2 py-1.5">
                            <Icon Name="book" Size="14"/>
                            Meaning
                        </div>
                        <div role="columnheader" class="flex items-center gap-1.5 px-2 py-1.5">
                            <Icon Name="pen" Size="14"/>
                            Example
                        </div>
                        <div role="columnheader" class="flex items-center gap-1.5 px-2 py-1.5">
                            <Icon Name="clock" Size="14"/>
                            Status
                        </div>
                        <div role="columnheader" class="px-2 py-1.5">
                        </div>
                    </div>
                    @foreach (var entry in _items.Skip((_pageIndex - 1) * _pageSize).Take(_pageSize))
                    {
                        var stageTone = (int)entry.Stage switch { 0 => 0, 1 => 2, 2 => 5, _ => 4 };
                        <div @key="entry.Id" role="row"
                             class="group grid grid-cols-[minmax(0,1fr)_auto] items-start gap-y-1 border-b border-line px-1 py-2.5 transition-colors hover:bg-hov md:grid-cols-[minmax(0,26fr)_minmax(0,24fr)_minmax(0,28fr)_minmax(0,14fr)_minmax(0,8fr)] md:gap-y-0 md:px-0 md:py-2">
                            <div role="cell"
                                 class="flex min-w-0 items-start gap-1.5 px-1 md:col-start-1 md:row-start-1 md:px-2">
                                <button type="button" title="Star" aria-label="Star"
                                        aria-pressed="@(entry.IsFavorite ? "true" : "false")"
                                        class="nt-icon-btn shrink-0 @(entry.IsFavorite ? "text-[#dfab01]!" : string.Empty)"
                                        @onclick="@(() => ToggleFavoriteAsync(entry))">
                                    <Icon Name="star" Size="14" Fill="@entry.IsFavorite"/>
                                </button>
                                <div class="min-w-0 pt-0.5">
                                    <div class="flex flex-wrap items-baseline gap-x-2">
                                        <span
                                            class="break-words text-[15px] font-semibold text-ink md:text-sm">
                                            @entry.Term
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(entry.Reading))
                                        {
                                            <span class="font-mono text-xs text-mute">
                                                @entry.Reading
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.PartOfSpeech))
                                        {
                                            <span class="text-xs italic text-faint">
                                                @entry.PartOfSpeech
                                            </span>
                                        }
                                    </div>
                                    @if (entry.TagList.Length > 0)
                                    {
                                        <div class="mt-1 flex flex-wrap gap-1">
                                            @foreach (var tag in entry.TagList)
                                            {
                                                var tagTone = tag.Trim().ToLowerInvariant().Sum(c => c) % 9;
                                                <span class="nt-tag nt-tag-@(tagTone)">
                                                    @tag
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            <div role="cell"
                                 class="flex justify-end gap-0.5 px-1 transition-opacity max-md:col-start-2 max-md:row-start-1 md:col-start-5 md:row-start-1 md:px-2 md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100">
                                <button type="button" class="nt-icon-btn" title="Edit" aria-label="Edit"
                                        @onclick="@(() => OpenEditor(entry))">
                                    <Icon Name="edit" Size="14"/>
                                </button>
                                <button type="button" class="nt-icon-btn" title="Reset progress" aria-label="Reset progress"
                                        @onclick="@(() => ResetAsync(entry))">
                                    <Icon Name="reset" Size="14"/>
                                </button>
                                <button type="button" class="nt-icon-btn is-danger" title="Delete" aria-label="Delete"
                                        @onclick="@(() => DeleteAsync(entry))">
                                    <Icon Name="trash" Size="14"/>
                                </button>
                            </div>
                            <div role="cell"
                                 class="px-1 pl-[34px] text-ink max-md:col-span-2 md:col-start-2 md:row-start-1 md:px-2 md:pl-2">
                                @entry.Meaning
                            </div>
                            <div role="cell"
                                 class="px-1 pl-[34px] max-md:col-span-2 md:col-start-3 md:row-start-1 md:px-2 md:pl-2">
                                @if (!string.IsNullOrWhiteSpace(entry.Example))
                                {
                                    <div class="text-ink whitespace-pre-line">
                                        @entry.Example
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(entry.ExampleMeaning))
                                    {
                                        <div class="text-xs text-mute whitespace-pre-line">
                                            @entry.ExampleMeaning
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="hidden text-faint md:inline">
                                        —
                                    </span>
                                }
                            </div>
                            <div role="cell"
                                 class="flex flex-wrap items-center gap-x-2 px-1 pl-[34px] max-md:col-span-2 md:col-start-4 md:row-start-1 md:block md:px-2 md:pl-2">
                                <span class="nt-tag nt-tag-@(stageTone)">
                                    @Labels.Stage(entry.Stage)
                                </span>
                                <div class="text-xs text-faint md:mt-0.5">
                                    @Labels.Due(entry)
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <nav aria-label="Pagination"
                     class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-xs text-mute">
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                        <span aria-live="polite">
                            @firstShown–@lastShown of @_items.Count
                        </span>
                        <label class="flex items-center gap-1.5">
                            <span class="hidden sm:inline">
                                Rows per page
                            </span>
                            <select class="nt-input h-8! w-auto! py-0! text-xs md:h-7!" aria-label="Rows per page"
                                    value="@_pageSize" @onchange="OnPageSizeChanged">
                                @foreach (var size in PageSizeOptions)
                                {
                                    <option value="@size">
                                        @size
                                    </option>
                                }
                            </select>
                        </label>
                    </div>
                    @if (TotalPages > 1)
                    {
                        <div class="flex items-center gap-1">
                            <button type="button" class="nt-icon-btn disabled:pointer-events-none disabled:opacity-40"
                                    title="Previous page" aria-label="Previous page" disabled="@(_pageIndex <= 1)"
                                    @onclick="() => GoToPageAsync(_pageIndex - 1)">
                                <span class="inline-flex rotate-180">
                                    <Icon Name="chevron" Size="14"/>
                                </span>
                            </button>
                            <span class="px-2 sm:hidden">
                                @_pageIndex / @TotalPages
                            </span>
                            @foreach (var p in VisiblePages())
                            {
                                if (p == 0)
                                {
                                    <span class="hidden px-1 text-faint sm:inline" aria-hidden="true">
                                        …
                                    </span>
                                }
                                else
                                {
                                    <button type="button" @key="p"
                                            class="hidden h-8 min-w-8 items-center justify-center rounded-nt px-2 text-xs transition-colors sm:inline-flex md:h-7 md:min-w-7 @(p == _pageIndex ? "bg-nt-accent-soft font-medium text-nt-accent" : "text-mute hover:bg-hov hover:text-ink")"
                                            aria-label="Page @p" aria-current="@(p == _pageIndex ? "page" : null)"
                                            @onclick="() => GoToPageAsync(p)">
                                        @p
                                    </button>
                                }
                            }
                            <button type="button" class="nt-icon-btn disabled:pointer-events-none disabled:opacity-40"
                                    title="Next page" aria-label="Next page" disabled="@(_pageIndex >= TotalPages)"
                                    @onclick="() => GoToPageAsync(_pageIndex + 1)">
                                <Icon Name="chevron" Size="14"/>
                            </button>
                        </div>
                    }
                </nav>
            }
        </div>
    </div>
    
    <Add_EditNewWord @bind-IsOpen="_editorOpen" @bind-Entry="_selectedEntry" Tags="_tags" OnSaved="AddNewWord"/>
    
    <BulkImport @bind-IsOpen="_importOpen" OnRunImport="AfterImportAsync"></BulkImport>
    
</CascadingValue>