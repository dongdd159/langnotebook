@inherits LayoutComponentBase
@using LangNotebook.Components
@using LangNotebook.Data
@using LangNotebook.Helper
@using LangNotebook.Service
@implements IDisposable
@inject AppState State
@inject DatabaseInitializer Initializer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LibraryService Library
@inject ReviewService Reviews
@inject SettingsService SettingsSvc

<div class="flex h-dvh w-full overflow-hidden bg-desk text-nt-text pt-[env(safe-area-inset-top,0px)]">
    @if (_drawerOpen)
    {
        <div class="fixed inset-0 z-40 bg-black/30 backdrop-blur-xs md:hidden" aria-hidden="true"
             @onclick="CloseDrawer">
        </div>
    }
    <aside id="app-sidebar" aria-label="Sidebar"
           class="nt-cover shrink-0 h-full transition-all duration-300 ease-in-out
                  fixed inset-y-0 left-0 z-10 md:relative md:z-10 @AsideClass">
        <NavMenu @bind-DrawerOpen="_drawerOpen" @bind-Collapsed="_collapsed" Notebooks="_notebooks"
                 ActiveNotebookId="State.ActiveNotebookId" DueCount="_dueCount" OnSelectNotebook="SelectNotebookAsync"
                 OnReload="ReloadAsync"/>
    </aside>
    <div class="flex flex-1 flex-col h-full min-w-0 overflow-hidden relative z-0">
        <header class="flex min-h-12 w-full shrink-0 flex-wrap items-center gap-2 bg-desk px-3 py-1.5 sm:px-5">
            @if (_collapsed)
            {
                <button type="button" class="nt-icon-btn hidden shrink-0 text-mute md:inline-flex"
                        title="Expand sidebar" aria-label="Expand sidebar" aria-controls="app-sidebar"
                        aria-expanded="false" @onclick="ExpandSidebar">
                    <Icon Name="panel" Size="18"/>
                </button>
            }
            @if (!_drawerOpen)
            {
                <button type="button" class="nt-icon-btn md:hidden" title="Open menu" aria-label="Open menu"
                        aria-controls="app-sidebar" aria-expanded="false" @onclick="OpenDrawer">
                    <Icon Name="menu" Size="18"/>
                </button>
            }
            <nav aria-label="Breadcrumbs" class="flex min-w-0 flex-1 items-center gap-1 text-sm">
                <span class="hidden max-w-[12rem] truncate rounded px-1.5 py-0.5 text-mute hover:bg-hov sm:inline">
                    @ActiveNotebookName
                </span>
                <span class="hidden text-faint sm:inline">/</span>
                <span class="flex min-w-0 items-center gap-1.5 truncate rounded px-1.5 py-0.5 font-medium hover:bg-hov">
                    <Icon Name="@CurrentPage.Icon" Class="text-mute"/>
                    <span class="truncate">@CurrentPage.Title</span>
                </span>
            </nav>
            <div class="ml-auto flex shrink-0 items-center gap-1">
                <span class="mr-2 hidden text-xs text-faint lg:inline">Saved in browser</span>
                <select class="nt-input h-7! w-auto! max-w-[10rem] py-0! text-xs hidden sm:block lg:max-w-[14rem]"
                        aria-label="Active notebook" value="@_selectedNotebookValue" @onchange="OnNotebookChanged">
                    <option value="">All Notebooks</option>
                    @foreach (var notebook in _notebooks)
                    {
                        <option value="@notebook.Id">@notebook.Name</option>
                    }
                </select>
                <a href="review" style="text-decoration:none"
                   class="nt-btn @(_dueCount > 0 ? "nt-btn-primary" : string.Empty) px-2! sm:px-2.5!"
                   aria-label="Review, @_dueCount cards due">
                    <Icon Name="review" Size="14"/>
                    <span class="hidden sm:inline">
                        Review
                    </span>
                    @if (_dueCount > 0)
                    {
                        <span class="rounded-nt bg-white/25 px-1.5 text-xs leading-5">
                            @_dueCount
                        </span>
                    }
                </a>
                <button type="button" class="nt-icon-btn h-8! w-8! text-mute md:h-7! md:w-7!"
                        @onclick="ToggleThemeAsync"
                        aria-label="@(_dark ? "Switch to light theme" : "Switch to dark theme")"
                        title="@(_dark ? "Light theme" : "Dark theme")">
                    @if (_dark)
                    {
                        <svg class="h-[18px] w-[18px]" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                             stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                            <circle cx="10" cy="10" r="3.5"/>
                            <path
                                d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4"/>
                        </svg>
                    }
                    else
                    {
                        <svg class="h-[18px] w-[18px]" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                             stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16.5 11.5A6.5 6.5 0 018.5 3.5a6.5 6.5 0 108 8z"/>
                        </svg>
                    }
                </button>
                <span class="ml-1 flex h-6 w-6 items-center justify-center rounded-full bg-hov text-xs font-medium"
                      title="Dong">D</span>
            </div>
        </header>
        <main class="nt-scroll flex-1 overflow-y-auto overscroll-contain" id="main-content">
            @if (!_ready)
            {
                <div class="flex h-full flex-col items-center justify-center gap-3 text-nt-muted">
                    <div class="spinner">
                    </div>
                    <p class="m-0 text-sm">
                        Opening the database on your computer…
                    </p>
                </div>
            }
            else
            {
                <div class="nt-sheet mx-2 mb-4 min-h-[calc(100%-1rem)] sm:mx-4 md:mx-6 md:mb-6 md:pl-10">
                    @Body
                </div>
            }
        </main>
    </div>
    <div class="pointer-events-none fixed right-4 z-[70] flex flex-col items-end gap-2"
         style="bottom: calc(1rem + env(safe-area-inset-bottom, 0px))">
        @foreach (var toast in _toasts)
        {
            <div
                class="@($"pointer-events-auto max-w-[calc(100vw-2rem)] rounded-nt bg-nt-text px-3 py-2 text-sm text-nt-bg shadow-pop sm:max-w-sm {(toast.Kind == "error" ? "bg-nt-danger! text-white!" : string.Empty)}")"
                role="status" @key="toast.Id">
                @toast.Message
            </div>
        }
    </div>
</div>