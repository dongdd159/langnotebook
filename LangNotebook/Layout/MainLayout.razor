@inherits LayoutComponentBase
@using LangNotebook.Components
@using LangNotebook.Data
@using LangNotebook.Helper
@using LangNotebook.Service
@implements IDisposable
@inject AppState State
@inject DatabaseInitializer Initializer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LibraryService Library
@inject ReviewService Reviews
@inject SettingsService SettingsSvc

<div class="flex h-dvh w-screen overflow-hidden bg-page text-ink font-ui pt-[env(safe-area-inset-top,0px)]">
    <div @onclick="CloseDrawer"
         class="fixed inset-0 z-30 bg-black/40 md:hidden transition-opacity duration-300
                @(_drawerOpen ? "opacity-100 pointer-events-auto" : "opacity-0 pointer-events-none")">
    </div>
    <NavMenu @bind-DrawerOpen="_drawerOpen"
             @bind-Collapsed="_collapsed"
             Notebooks="_notebooks"
             ActiveNotebookId="State.ActiveNotebookId"
             DueCount="_dueCount"
             OnSelectNotebook="SelectNotebookAsync" />

    <!-- 3. KHUNG WORKSPACE (Cột phải tự động chiếm toàn bộ chiều rộng còn lại) -->
    <div class="flex flex-1 flex-col h-full min-w-0 overflow-hidden">

        <!-- TOPBAR: Tự động tự giãn theo chiều rộng của Khung Workspace -->
        <header class="flex h-12 w-full shrink-0 items-center gap-2 border-b border-line bg-page px-3">
            
            <!-- Nút mở Drawer trên Mobile -->
            @if (!_drawerOpen)
            {
                <button type="button" class="nt-icon-btn shrink-0 text-mute md:hidden" @onclick="OpenDrawer">
                    <Icon Name="menu" Size="20"/>
                </button>
            }

            <!-- Nút mở lại Sidebar trên PC khi đang thu gọn -->
            @if (_collapsed)
            {
                <button type="button" class="nt-icon-btn hidden shrink-0 text-mute md:inline-flex" @onclick="ExpandSidebar">
                    <Icon Name="panel" Size="18"/>
                </button>
            }

            <!-- Breadcrumb (Đường dẫn trang) -->
            <nav aria-label="Đường dẫn" class="flex min-w-0 flex-1 items-center gap-1 text-sm">
                <span class="hidden max-w-[12rem] truncate rounded px-1.5 py-0.5 text-mute hover:bg-hov sm:inline">
                    @ActiveNotebookName
                </span>
                <span class="hidden text-faint sm:inline">/</span>
                <span class="flex min-w-0 items-center gap-1.5 truncate rounded px-1.5 py-0.5 font-medium hover:bg-hov">
                    <Icon Name="@CurrentPage.Icon" Class="text-mute"/>
                    <span class="truncate">@CurrentPage.Title</span>
                </span>
            </nav>

            <!-- Nút chức năng góc phải -->
            <div class="ml-auto flex shrink-0 items-center gap-1">
                <!-- Select notebook, Ôn tập, Toggle Theme, Avatar... -->
            </div>

        </header>
    </div>
</div>
