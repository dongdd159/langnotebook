@using LangNotebook.Components
@using LangNotebook.Data
@using LangNotebook.Helper
@using LangNotebook.Service
@inject AppState State
@inject DatabaseInitializer Initializer
@inject LibraryService Library
@inject ReviewService Reviews
@inject SettingsService SettingsSvc
@inject IJSRuntime JS

<nav class="flex h-full min-h-0 flex-col" aria-label="Main menu">
    <div class="flex shrink-0 items-center justify-between gap-2 px-3 pb-2 pt-4">
        <div class="@($"flex min-w-0 flex-1 items-center gap-2.5 rounded-md py-2 {(Collapsed ? "md:border-0 md:px-0" : string.Empty)} border border-white/20 px-2.5")">
            <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-nt bg-[#fcfbf8] text-[13px] font-semibold text-[#1f2a3a] select-none">
                語
            </span>
            <span class="flex min-w-0 flex-col leading-tight @(Collapsed ? "md:hidden" : string.Empty)">
                <span class="truncate font-serif text-base font-semibold text-white">Language Notebook</span>
                <span class="truncate text-[11px] text-[color:var(--nt-cover-muted)]">Personal study journal</span>
            </span>
        </div>
        @if (!Collapsed)
        {
            <button type="button" class="nt-icon-btn hidden shrink-0 md:inline-flex" title="Collapse sidebar"
                    aria-label="Collapse sidebar" @onclick="CollapseAsync">
                <Icon Name="close-panel" Size="18"/>
            </button>
        }
        @if (DrawerOpen)
        {
            <button type="button" class="nt-icon-btn md:hidden" title="Collapse sidebar" aria-label="Collapse sidebar"
                    @onclick="CloseDrawerAsync">
                <Icon Name="close" Size="18"/>
            </button>
        }
    </div>
    <div class="nt-scroll min-h-0 flex-1 min-w-0 overflow-y-auto overflow-x-hidden overscroll-contain px-2 py-3">
        <div class="flex flex-col gap-0.5">
            <NavLink class="nt-side-item" href="" Match="NavLinkMatch.All" ActiveClass="active" title="Overview">
                <Icon Name="home"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Overview
                </span>
            </NavLink>
            <NavLink class="nt-side-item" href="review" ActiveClass="active" title="Review">
                <Icon Name="review"/>
                <span class="flex-1 truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Review
                </span>
                @if (DueCount > 0)
                {
                    <span
                        class="rounded-[4px] bg-white/15 px-1.5 text-xs font-semibold leading-5 text-white @(Collapsed ? "md:hidden" : string.Empty)">
                        @DueCount
                    </span>
                }
            </NavLink>
        </div>
        <div class="nt-side-title @(Collapsed ? "md:hidden" : string.Empty)">
            Study Modules
        </div>
        <div class="flex flex-col gap-0.5">
            <NavLink class="nt-side-item" href="vocabulary" ActiveClass="active" title="Vocabulary">
                <Icon Name="book"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Vocabulary
                </span>
            </NavLink>
            <NavLink class="nt-side-item" href="grammar" ActiveClass="active" title="Grammar &amp; Structures">
                <Icon Name="grammar"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Grammar &amp; Structures
                </span>
            </NavLink>
            <NavLink class="nt-side-item" href="writing" ActiveClass="active" title="Writing Practice">
                <Icon Name="pen"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Writing Practice
                </span>
            </NavLink>
        </div>
        <div class="nt-side-title @(Collapsed ? "md:hidden" : string.Empty)">
            Your Notebooks
        </div>
        <div class="flex flex-col gap-0.5">
            <button type="button"
                    class="nt-side-item w-full text-left @(ActiveNotebookId is null ? "active" : string.Empty)"
                    title="All Notebooks" @onclick="() => SelectAsync(null)">
                <span class="flex h-4 w-4 shrink-0 items-center justify-center text-[color:var(--nt-cover-muted)]">
                    <Icon Name="library" Size="14"/>
                </span>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    All Notebooks
                </span>
            </button>
            @if (_openEdit)
            {
                <div class="nt-side-item w-full">
                    <span class="h-3.5 w-3.5 shrink-0 rounded-[3px]">
                    </span>
                    <input class="nt-input w-full" value="@InputValue" @oninput="OnInputChanged" @onkeydown="OnKeyDown"
                           @onblur="OnBlur" @ref="_inputNotebook"/>
                </div>
            }
            @if (_loading)
            {
                <div class="flex flex-col gap-1 px-1" aria-busy="true">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="h-9 animate-pulse rounded-nt bg-white/10">
                        </div>
                    }
                </div>
            }
            else
            {
                @foreach (var notebook in Notebooks)
                {
                    <button type="button" @key="notebook.Id"
                            class="group relative flex items-center justify-between nt-side-item w-full text-left @(ActiveNotebookId == notebook.Id ? "active" : string.Empty)"
                            title="@notebook.Name" @onclick="() => SelectAsync(notebook.Id)">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="h-3.5 w-3.5 shrink-0 rounded-[3px]" style="background:@notebook.ColorHex">
                            </span>
                            <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                                @notebook.Name
                            </span>
                        </div>
                        <div
                            class="shrink-0 transition-opacity @(ActiveNotebookId == notebook.Id ? "opacity-100" : "opacity-0 group-hover:opacity-100") @(Collapsed ? "md:hidden" : string.Empty)"
                            @onclick:stopPropagation="true">
                            <button type="button" class="nt-icon-btn is-danger h-6 w-6" title="Delete"
                                    aria-label="Delete" @onclick="() => DeleteNotebookAsync(notebook.Id)">
                                <Icon Name="trash" Size="12"/>
                            </button>
                        </div>
                    </button>
                }
                <button class="nt-side-item" ActiveClass="active" title="New Notebook" @onclick="AddNewNotebook">
                    <Icon Name="plus"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                        New Notebook
                    </span>
                </button>
            }
        </div>
        <div class="nt-side-title @(Collapsed ? "md:hidden" : string.Empty)">
            Tracking
        </div>
        <div class="flex flex-col gap-0.5">
            <NavLink class="nt-side-item" href="stats" ActiveClass="active" title="Statistics">
                <Icon Name="chart"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Statistics
                </span>
            </NavLink>
            <NavLink class="nt-side-item" href="notebooks" ActiveClass="active" title="Manage Notebooks">
                <Icon Name="database"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Manage Notebooks
                </span>
            </NavLink>
            <NavLink class="nt-side-item" href="settings" ActiveClass="active" title="Settings">
                <Icon Name="settings"/>
                <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">
                    Settings
                </span>
            </NavLink>
        </div>
    </div>
    <div
        class="mt-auto shrink-0 border-t border-white/10 px-4 py-3 text-xs text-[color:var(--nt-cover-muted)] pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] @(Collapsed ? "md:hidden" : string.Empty)">
        Data is saved locally on your device
    </div>
</nav>