@using LangNotebook.Components
@using LangNotebook.Data
@using LangNotebook.Helper
@using LangNotebook.Service
@inject AppState State
@inject DatabaseInitializer Initializer
@inject LibraryService Library
@inject ReviewService Reviews
@inject SettingsService SettingsSvc

<aside id="app-sidebar"
       aria-label="Thanh bên"
       class="shrink-0 h-full bg-nt-side border-r border-line transition-all duration-300 ease-in-out
              fixed inset-y-0 left-0 z-40 md:static md:z-auto 
              pt-[env(safe-area-inset-top,0px)] @AsideClass"
       @onkeydown="OnKeyDown">
    <nav class="flex h-full min-h-0 flex-col" aria-label="Menu chính">
        <div class="flex h-12 shrink-0 items-center justify-between gap-2 px-3 border-b border-line/40">
            <div class="flex min-w-0 items-center gap-2.5">
                <span
                    class="flex h-6 w-6 shrink-0 items-center justify-center rounded-nt bg-nt-text text-xs font-semibold text-nt-bg select-none">語</span>
                <span class="truncate text-sm font-semibold text-nt-text @(Collapsed ? "md:hidden" : string.Empty)">
                    Sổ tay ngoại ngữ
                </span>
            </div>
            <button type="button" class="nt-icon-btn md:hidden" title="Đóng menu" aria-label="Đóng menu"
                    @ref="_closeButton" @onclick="CloseDrawerAsync">
                <Icon Name="close" Size="18"/>
            </button>
            <button type="button" class="nt-icon-btn hidden md:inline-flex" title="Thu gọn thanh bên"
                    aria-label="Thu gọn thanh bên"
                    @onclick="CollapseAsync">
                <Icon Name="chevrons-left" Size="18"/>
            </button>
        </div>
        <div class="nt-scroll min-h-0 flex-1 overflow-y-auto overflow-x-hidden overscroll-contain px-2 py-3">
            <div class="flex flex-col gap-0.5">
                <NavLink class="nt-side-item" href="" Match="NavLinkMatch.All" ActiveClass="active" title="Tổng quan">
                    <Icon Name="home"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Tổng quan</span>
                </NavLink>

                <NavLink class="nt-side-item" href="review" ActiveClass="active" title="Ôn tập">
                    <Icon Name="review"/>
                    <span class="flex-1 truncate @(Collapsed ? "md:hidden" : string.Empty)">Ôn tập</span>
                    @if (DueCount > 0)
                    {
                        <span
                            class="rounded-nt bg-nt-accent-soft px-1.5 text-xs font-medium leading-5 text-nt-accent @(Collapsed ? "md:hidden" : string.Empty)">
                            @DueCount
                        </span>
                    }
                </NavLink>
            </div>
            <div class="nt-side-title @(Collapsed ? "md:hidden" : string.Empty)">Sổ ghi chép</div>
            <div class="flex flex-col gap-0.5">
                <NavLink class="nt-side-item" href="vocabulary" ActiveClass="active" title="Từ vựng">
                    <Icon Name="book"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Từ vựng</span>
                </NavLink>

                <NavLink class="nt-side-item" href="grammar" ActiveClass="active" title="Mẫu câu & cấu trúc">
                    <Icon Name="grammar"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Mẫu câu &amp; cấu trúc</span>
                </NavLink>

                <NavLink class="nt-side-item" href="writing" ActiveClass="active" title="Luyện viết">
                    <Icon Name="pen"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Luyện viết</span>
                </NavLink>
            </div>
            <div class="nt-side-title @(Collapsed ? "md:hidden" : string.Empty)">Sổ của bạn</div>
            <div class="flex flex-col gap-0.5">
                <button type="button"
                        class="nt-side-item w-full text-left @(ActiveNotebookId is null ? "active" : string.Empty)"
                        title="Tất cả các sổ"
                        @onclick="() => SelectAsync(null)">
                    <span class="flex h-4 w-4 shrink-0 items-center justify-center text-nt-faint"><Icon Name="library"
                                                                                                        Size="14"/></span>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Tất cả các sổ</span>
                </button>
                @foreach (var notebook in Notebooks)
                {
                    <button type="button" @key="notebook.Id"
                            class="nt-side-item w-full text-left @(ActiveNotebookId == notebook.Id ? "active" : string.Empty)"
                            title="@notebook.Name"
                            @onclick="() => SelectAsync(notebook.Id)">
                        <span class="h-3.5 w-3.5 shrink-0 rounded-[3px]" style="background:@notebook.ColorHex"></span>
                        <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">@notebook.Name</span>
                    </button>
                }
            </div>
            <div class="nt-side-title @(Collapsed ? "md:hidden" : string.Empty)">Theo dõi</div>
            <div class="flex flex-col gap-0.5">
                <NavLink class="nt-side-item" href="stats" ActiveClass="active" title="Thống kê">
                    <Icon Name="chart"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Thống kê</span>
                </NavLink>
                <NavLink class="nt-side-item" href="notebooks" ActiveClass="active" title="Quản lý sổ">
                    <Icon Name="database"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Quản lý sổ</span>
                </NavLink>
                <NavLink class="nt-side-item" href="settings" ActiveClass="active" title="Cài đặt">
                    <Icon Name="settings"/>
                    <span class="truncate @(Collapsed ? "md:hidden" : string.Empty)">Cài đặt</span>
                </NavLink>
            </div>
        </div>
        <div
            class="shrink-0 border-t border-line px-3 py-3 text-xs text-faint pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] @(Collapsed ? "md:hidden" : string.Empty)">
            Dữ liệu lưu ngay trên máy bạn
        </div>
    </nav>
</aside>