@using LangNotebook.Helper
@using LangNotebook.Service
@inject CloudBackupService Cloud
@inject NavigationManager Nav
@implements IDisposable

<button type="button"
        class="@($"nt-icon-btn h-8! w-8! md:h-7! md:w-7! {ToneClass}")"
        @onclick="OnClickAsync"
        aria-disabled="@(Working ? "true" : "false")"
        aria-label="@Label"
        aria-describedby="cloud-backup-status"
        title="@Tooltip"
        aria-busy="@(Working ? "true" : "false")">
    <span class="relative inline-flex">
        <Icon Name="@IconName" Size="18" Class="@(Working ? "animate-spin motion-reduce:animate-none" : string.Empty)"/>
        @if (ShowDot)
        {
            <span class="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-nt-warn" aria-hidden="true"></span>
        }
    </span>
</button>
<span id="cloud-backup-status" class="sr-only">@Tooltip</span>
<span class="sr-only" role="status" aria-live="polite">@_announcement</span>
