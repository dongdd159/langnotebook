@if (Visible)
{
    <div class="fixed inset-0 z-[60] flex items-start justify-center overflow-y-auto bg-nt-overlay p-4 sm:items-center"
         @onclick="CloseAsync">
        <div class="@($"my-auto w-full rounded-md bg-nt-bg text-nt-text shadow-pop {WidthClass}")"
             role="dialog" aria-modal="true" aria-label="@Title"
             @onclick:stopPropagation="true">
            <div class="flex items-center justify-between gap-3 px-5 pb-2 pt-4">
                <h2 class="m-0 text-base font-semibold">@Title</h2>
                <button type="button" class="nt-icon-btn" @onclick="CloseAsync" title="Đóng">
                    <Icon Name="close" />
                </button>
            </div>
            <div class="px-5 pb-5 pt-2">
                @ChildContent
            </div>
        </div>
    </div>
}