{
  "_readme": "Defaults for every value that differs between deployments. Do not put real values here (this file is committed). To change something, copy this file to app.config.json in the same folder: that file is git-ignored, and anything it contains replaces the same top-level section here (cloud, ai). See docs/configuration.md.",

  "cloud": {
    "dropbox": { "clientId": "" },
    "google": { "clientId": "" }
  },

  "ai": {
    "anthropic": {
      "apiVersion": "2026-10-21",
      "betaHeader": "server-side-fallback-2026-07-01"
    },
    "providers": [
      {
        "id": "anthropic",
        "name": "Anthropic (Claude)",
        "protocol": "anthropic",
        "endpoint": "https://api.anthropic.com/v1/messages",
        "defaultModel": "claude-opus-5-5",
        "modelHint": "claude-opus-5-5"
      },
      {
        "id": "openai",
        "name": "OpenAI",
        "protocol": "openai",
        "endpoint": "https://api.openai.com/v1/chat/completions",
        "defaultModel": "",
        "modelHint": "gpt-5"
      },
      {
        "id": "gemini",
        "name": "Google Gemini",
        "protocol": "openai",
        "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "defaultModel": "",
        "modelHint": "gemini-2.5-flash"
      },
      {
        "id": "openrouter",
        "name": "OpenRouter",
        "protocol": "openai",
        "endpoint": "https://openrouter.ai/api/v1/chat/completions",
        "defaultModel": "",
        "modelHint": "openai/gpt-5"
      },
      {
        "id": "groq",
        "name": "Groq",
        "protocol": "openai",
        "endpoint": "https://api.groq.com/openai/v1/chat/completions",
        "defaultModel": "",
        "modelHint": "llama-3.3-70b-versatile"
      },
      {
        "id": "mistral",
        "name": "Mistral",
        "protocol": "openai",
        "endpoint": "https://api.mistral.ai/v1/chat/completions",
        "defaultModel": "",
        "modelHint": "mistral-large-latest"
      },
      {
        "id": "deepseek",
        "name": "DeepSeek",
        "protocol": "openai",
        "endpoint": "https://api.deepseek.com/chat/completions",
        "defaultModel": "",
        "modelHint": "deepseek-chat"
      },
      {
        "id": "xai",
        "name": "xAI (Grok)",
        "protocol": "openai",
        "endpoint": "https://api.x.ai/v1/chat/completions",
        "defaultModel": "",
        "modelHint": "grok-4"
      },
      {
        "id": "together",
        "name": "Together AI",
        "protocol": "openai",
        "endpoint": "https://api.together.xyz/v1/chat/completions",
        "defaultModel": "",
        "modelHint": "meta-llama/Llama-3.3-70B-Instruct-Turbo"
      },
      {
        "id": "custom",
        "name": "Custom endpoint",
        "protocol": "openai",
        "endpoint": "",
        "defaultModel": "",
        "modelHint": "the model name your server expects",
        "keyRequired": false
      }
    ]
  }
}
